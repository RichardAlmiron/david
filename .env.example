# ==============================================================================
# VARIABLES DE ENTORNO PARA RAILWAY & SERVIDOR LOCAL
# ==============================================================================

# 1. OPENROUTER & GLM-5.3 (Motor de Codificación en Vivo y Creativos Pipeboard)
# El sistema detecta automáticamente cualquier variable que tengas en Railway:
# OPENROUTER_API_KEY, OPENROUTESERVICE_API_KEY, OPENROUTE_SERVICE_API_KEY, OPENROUTESERVICE o OPENROUTER_KEY
OPENROUTER_API_KEY=sk-or-v1-tu-clave-de-openrouter
OPENROUTER_MODEL=z-ai/glm-5.3

# 2. DEEPGRAM (Motor de Audio y Voz en Tiempo Real para Agente de WhatsApp y Portavoz)
DEEPGRAM_API_KEY=fe2a93361cde252fff48ad5ac92dbf85cb5a2f51

# 3. META ADS & PIXEL (Biblioteca de Anuncios y First-Party CAPI Server)
META_ADS_ACCESS_TOKEN=tu-token-de-meta-ad-library
META_PIXEL_ID=
META_CAPI_TOKEN=

# 4. PUERTO DE SERVIDOR (Railway asigna PORT automáticamente)
PORT=3000
